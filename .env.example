
# --- Banco de dados (MySQL) ---
MYSQL_ROOT_PASSWORD=troque_esta_senha_root
MYSQL_DATABASE=site_realiza
MYSQL_USER=admin
MYSQL_PASSWORD=troque_esta_senha

# --- Conexão do backend e do microserviço com o banco ---
DB_HOST=mysql
DB_USER=admin
DB_PASSWORD=troque_esta_senha
DB_NAME=site_realiza

# --- Backend ---
PORT=3000

# --- Redis (cache e Pub/Sub) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Microserviço de notificações ---
NOTIFICATION_PORT=3001
# Deve ser igual ao segredo usado pelo backend para assinar o login (hoje fixo no código do backend)
JWT_SECRET=segredo_super_secreto

# --- E-mail ---
# teste = caixa simulada (nada é entregue de verdade); smtp = envio real com as variáveis SMTP_*
EMAIL_MODE=teste
EMAIL_FROM=Realiza Anti Chamas <notificacoes@realiza.local>
# Para onde vai o aviso de "novo orçamento"
ADMIN_EMAIL=admin@realiza.local

# --- SMTP (somente se EMAIL_MODE=smtp) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=